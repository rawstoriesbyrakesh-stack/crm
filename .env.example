# ==========================================
# Frontend Environment Variables
# ==========================================
VITE_API_URL=http://localhost:8787/api
# STAGING: VITE_API_URL=https://staging-api.yourdomain.com/api
# PROD: VITE_API_URL=https://api.yourdomain.com/api

# ==========================================
# Backend Environment Variables
# ==========================================
PORT=8787
CORS_ORIGIN=*

# Admin Credentials
RAWSTORIES_EMAIL=admin@yourdomain.com
RAWSTORIES_PASSWORD=securepassword
RAWSTORIES_TOKEN=super_secret_session_token

# MongoDB Configuration
# STAGING: mongodb+srv://.../rawstories-staging
# PROD: mongodb+srv://.../rawstories-prod
MONGO_URI=mongodb://localhost:27017/rawstories

# S3 (Cloudflare R2 / Generic) Configuration
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=your-bucket-name

PRESIGNED_URL_EXPIRY=3600
FRONTEND_URL=http://localhost:5173
# STAGING: FRONTEND_URL=https://staging.yourdomain.com
# PROD: FRONTEND_URL=https://yourdomain.com
