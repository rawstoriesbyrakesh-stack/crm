# Admin credentials
RAWSTORIES_EMAIL=admin@example.com
RAWSTORIES_PASSWORD=changeme
# Optional: set a fixed session token (if not set, the server generates one each start)
RAWSTORIES_TOKEN=replace-with-a-secret-or-uuid
PORT=8787
# Optional: restrict CORS origin (default is '*')
CORS_ORIGIN=*

# Wasabi S3 Configuration
WASABI_ACCESS_KEY=your-wasabi-access-key
WASABI_SECRET_KEY=your-wasabi-secret-key
WASABI_REGION=us-east-1
WASABI_BUCKET=your-bucket-name
WASABI_ENDPOINT=https://s3.us-east-1.wasabisys.com
