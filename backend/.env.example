# Admin credentials
RAWSTORIES_EMAIL=admin@example.com
RAWSTORIES_PASSWORD=    
# Optional: set a fixed session token (if not set, the server generates one each start)
RAWSTORIES_TOKEN=replace-with-a-secret-or-uuid
PORT=8787
# Optional: restrict CORS origin (default is '*')
CORS_ORIGIN=*

# Generic S3 / Cloudflare R2 Configuration
S3_ACCESS_KEY=your-s3-access-key-id
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
